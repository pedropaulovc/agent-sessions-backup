// Sev1: fires on any hub-originated sessions-hub log line in the last hour that
// carries a D1 capacity rejection, i.e. a D1 database (or the account's D1
// storage) is full and the hub can no longer persist uploads/heartbeats.
//
// Capacity set: the `capacity` class of infra/cf/d1-batch-atomicity.mjs —
// SQLITE_FULL, `database or disk is full`, `Exceeded maximum DB size`, and
// `Your account has exceeded D1's maximum account storage limit`. Each must
// appear in a D1_ERROR line, mirroring parse-errors.kql's transientD1 origin
// anchor, so a user-controlled path that merely embeds a phrase cannot page.
//
// Matches the raw Body, not a structured `event`: in the 2026-11-12 outage
// ~14,100 of the ~14,700 such lines were bare `D1_ERROR: Exceeded maximum DB
// size` strings with no event field; the rest arrived inside parse.error and
// hub.pricing.batch_pass_failed events. parse-errors.kql excludes the same D1
// capacity set so the outage pages here, at Sev1.
//
// `collector.event` lines are dropped first: their `payload` is
// collector-controlled (hub/src/api/ops.ts), and replayed collector upload
// errors can quote hub responses, so they must neither forge nor re-raise this.
//
// Window 1h, evaluated every 15m (provision.sh): the overlap tolerates
// OTLP/DCR ingestion delay at evaluation boundaries; the alert is stateful.
// `contains` (substring, case-insensitive), not `has`: `has` is term-based and
// does not reliably match multi-word phrases or the underscored D1_ERROR token.
// A bare summarize always yields one row, so `where lines > 0` drops it on a
// healthy window; otherwise that one compact row trips provision.sh's
// `count > 0`. Missing OTelLogs degrades to empty.
let otel = union isfuzzy=true
    (datatable(TimeGenerated:datetime, Body:string, ServiceName:string)[]),
    (OTelLogs | project TimeGenerated, Body, ServiceName);
otel
| where TimeGenerated > ago(1h)
| where ServiceName == 'sessions-hub'
| where Body contains "D1_ERROR"
| where tostring(todynamic(Body).event) != "collector.event"
| where Body contains "SQLITE_FULL"
    or Body contains "database or disk is full"
    or Body contains "Exceeded maximum DB size"
    or Body contains "exceeded D1's maximum account storage limit"
| summarize lines = count(), first_at = min(TimeGenerated), last_at = max(TimeGenerated),
    samples = make_set(substring(Body, 0, 300), 5)
| where lines > 0
