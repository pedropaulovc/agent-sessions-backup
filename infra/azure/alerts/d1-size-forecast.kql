// Fires when any D1 database is projected to reach its cap in under 3 days at
// its current growth trend.
//
// Cap: 10 GB decimal (10,000,000,000 bytes). Production `main` plateaued at
// 9,999,998,976 bytes when writes began failing with `Exceeded maximum DB size`
// (2026-11-12 00:05 UTC), so the cap is decimal GB, not GiB. The GiB thresholds
// in d1-size.kql / d1-size-critical.kql are fixed fractions below that cap.
//
// Trend: per database, a least-squares line through the */15 watchdog
// hub.d1.db_size_bytes gauges (see d1-size.kql) of the last 48h, fitted from
// the latest confirmed shrink onward, so a cleanup restarts the fit instead of
// a pre-shrink endpoint masking regrowth.
//   - Readings <= 0 are dropped: -1 is a failed probe (owned by d1-size.kql)
//     and a 0-byte size is never a real database.
//   - A step is a change from the neighbouring reading of more than
//     max(1%, 50 MB). The absolute floor keeps small shards' sub-MB wobble
//     (IDX shards dip by <1 MB) from counting as a step.
//   - Outliers are handled symmetrically and excluded from the fit, so a lone
//     bad gauge gets neither a restart nor endpoint leverage:
//       * high spike: a step up from its predecessor that is not sustained
//         (also a step above its successor, or it is the newest reading). It
//         is removed BEFORE drop detection, so the fall back from a spike is
//         not mistaken for a shrink;
//       * low glitch: a step down that the next reading does not confirm
//         (next reading back within the step of the predecessor, or it is the
//         newest reading).
//   - A step down confirmed by the next reading is a shrink; the fit then
//     starts at the first post-shrink reading.
//   An unconfirmed newest step (either direction) only waits one */15 reading.
// The fitted segment needs >= 12h span and >= 24 readings, so a burst right
// after a deploy, new shard, shrink, or rule bootstrap cannot extrapolate a
// false deadline. Shrinking or flat trends never fire. A database that reached
// the cap keeps firing here (days_to_full <= 0) until its pre-cap growth ages
// out of the 48h window; d1-size-critical.kql and d1-db-full-errors.kql own
// the at-cap state.
//
// Provision.sh evaluates hourly over a 48h window with overrideQueryTimeRange
// P2D so the oldest gauge stays inside the query range. The 48h scan and JSON
// parse happen once: `classified` is materialized and read twice.
let otel = union isfuzzy=true
    (datatable(TimeGenerated:datetime, Body:string, ServiceName:string)[]),
    (OTelLogs | project TimeGenerated, Body, ServiceName);
let cap_gb = 10.0;
let window_start = ago(48h);
let classified = materialize(otel
    | where TimeGenerated > window_start
    | where ServiceName == 'sessions-hub'
    | extend body = todynamic(Body)
    | where body.event == "hub.d1.db_size_bytes"
    | extend bytes = tolong(body.bytes), database = iff(isempty(tostring(body.database)), "main", tostring(body.database))
    | where bytes > 0
    | project database, TimeGenerated, bytes
    | order by database asc, TimeGenerated asc
    | extend prev_bytes = iff(prev(database) == database, prev(bytes), long(null)),
        next_bytes = iff(next(database) == database, next(bytes), long(null))
    | extend spike = isnotnull(prev_bytes) and bytes > prev_bytes + max_of(0.01 * prev_bytes, 50e6)
        and (isnull(next_bytes) or bytes > next_bytes + max_of(0.01 * next_bytes, 50e6))
    | where not(spike)
    | project database, TimeGenerated, bytes
    | order by database asc, TimeGenerated asc
    | extend prev_bytes = iff(prev(database) == database, prev(bytes), long(null)),
        next_bytes = iff(next(database) == database, next(bytes), long(null))
    | extend drop_floor = prev_bytes - max_of(0.01 * prev_bytes, 50e6)
    | extend dropped = isnotnull(prev_bytes) and bytes < drop_floor
    | extend shrank = dropped and isnotnull(next_bytes) and next_bytes < drop_floor
    | extend glitch = dropped and not(shrank));
let segments = classified
    | summarize last_shrink_at = maxif(TimeGenerated, shrank) by database
    | extend fit_from = iff(isnull(last_shrink_at), window_start, last_shrink_at);
classified
| where not(glitch)
| join kind=inner segments on database
| where TimeGenerated >= fit_from
// x in days since window_start, y in GB: small magnitudes keep the
// closed-form least-squares sums numerically well-conditioned.
| extend x = (TimeGenerated - window_start) / 1d, y = bytes / 1e9
| summarize n = count(), sx = sum(x), sy = sum(y), sxx = sum(x * x), sxy = sum(x * y),
    oldest_at = min(TimeGenerated), arg_max(TimeGenerated, newest_bytes = bytes) by database
| where n >= 24 and TimeGenerated - oldest_at >= 12h
| extend gb_per_day = (n * sxy - sx * sy) / (n * sxx - sx * sx)
| where gb_per_day > 0
| extend days_to_full = (cap_gb - newest_bytes / 1e9) / gb_per_day
| where days_to_full < 3
| project newest_at = TimeGenerated, database, newest_bytes, bytes_per_day = tolong(gb_per_day * 1e9),
    days_to_full = round(days_to_full, 2), fitted_since = oldest_at, readings = n
