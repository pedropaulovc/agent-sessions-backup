// Fires when any D1 database is projected to reach its cap in under 3 days at
// its growth rate over the last 48h.
//
// Cap: 10 GB decimal (10,000,000,000 bytes). Production `main` plateaued at
// 9,999,998,976 bytes when writes began failing with `Exceeded maximum DB size`
// (2026-11-12 00:05 UTC), so the cap is decimal GB, not GiB. The GiB thresholds
// in d1-size.kql / d1-size-critical.kql are fixed fractions below that cap.
//
// Rate: (newest - oldest healthy gauge) / elapsed, per database, from the */15
// watchdog's hub.d1.db_size_bytes gauges (see d1-size.kql). At least 24h of
// span is required so a short-lived burst right after a deploy, new shard, or
// rule bootstrap cannot extrapolate a false deadline. Failed probes (bytes=-1)
// are excluded and stay owned by d1-size.kql. Shrinking or flat databases
// (rate <= 0) never fire. A database that reached the cap keeps firing here
// (days_to_full <= 0) until its pre-cap growth ages out of the 48h window;
// d1-size-critical.kql and d1-db-full-errors.kql own the at-cap state.
//
// Provision.sh evaluates hourly over a 48h window with overrideQueryTimeRange
// P2D so the oldest gauge stays inside the query range.
let otel = union isfuzzy=true
    (datatable(TimeGenerated:datetime, Body:string, ServiceName:string)[]),
    (OTelLogs | project TimeGenerated, Body, ServiceName);
let cap_bytes = 10000000000.0;
otel
| where TimeGenerated > ago(48h)
| where ServiceName == 'sessions-hub'
| extend body = todynamic(Body)
| where body.event == "hub.d1.db_size_bytes"
| extend bytes = tolong(body.bytes), database = iff(isempty(tostring(body.database)), "main", tostring(body.database))
| where bytes >= 0
| summarize arg_min(TimeGenerated, oldest_bytes = bytes), arg_max(TimeGenerated, newest_bytes = bytes) by database
| project database, oldest_at = TimeGenerated, newest_at = TimeGenerated1, oldest_bytes, newest_bytes
| where newest_at - oldest_at >= 24h
| extend bytes_per_day = (newest_bytes - oldest_bytes) / ((newest_at - oldest_at) / 1d)
| where bytes_per_day > 0
| extend days_to_full = (cap_bytes - newest_bytes) / bytes_per_day
| where days_to_full < 3
| project newest_at, database, newest_bytes, bytes_per_day = tolong(bytes_per_day), days_to_full = round(days_to_full, 2)
