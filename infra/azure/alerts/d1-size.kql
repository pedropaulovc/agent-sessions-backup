// Fires when any D1 database approaches its 10 GB hard cap (warning at 7 GiB)
// or when that database's size probe fails.
//
// The */15 watchdog emits one gauge per database:
//   { event: "hub.d1.db_size_bytes", database: "main" | "IDX00" | ..., bytes: <n> }
// bytes=-1 identifies a failed probe. A small healthy shard must not hide a
// full or unreadable sibling. Workers observability exports the JSON to OTelLogs.
// Historical events without database identify the pre-sharding main database.
//
// A 1h window comfortably contains a watchdog emission (it runs every 15 min);
// Take each database's most recent gauge within the window.
// No pipeline-silent sentinel is needed here: total telemetry silence is already
// covered by missed-heartbeat.kql's __pipeline_silent__ row.

// `otel` wraps OTelLogs in `union isfuzzy=true` so a missing table (before the
// first OTLP log lands) degrades to empty instead of erroring the whole rule —
// see missed-heartbeat.kql's "Missing-table guard" note for the full rationale.
let otel = union isfuzzy=true
    (datatable(TimeGenerated:datetime, Body:string)[]),
    (OTelLogs | project TimeGenerated, Body);
otel
| where TimeGenerated > ago(1h)
| extend body = todynamic(Body)
| where body.event == "hub.d1.db_size_bytes"
| extend bytes = tolong(body.bytes), database = iff(isempty(tostring(body.database)), "main", tostring(body.database))
| summarize arg_max(TimeGenerated, bytes) by database
| where bytes < 0 or bytes > 7 * 1024 * 1024 * 1024
| project TimeGenerated, database, bytes
