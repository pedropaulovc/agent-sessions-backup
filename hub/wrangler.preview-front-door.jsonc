{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sessions-preview-front-door",
  "main": "gateway/preview-front-door.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "18ef3246e9f36d1560485ef53889c0ab",
  "routes": [
    { "pattern": "*-preview.sessions.vza.net/*", "zone_name": "vza.net" },
    { "pattern": "preview-control.sessions.vza.net/*", "zone_name": "vza.net" }
  ],
  "vars": {
    "ACCESS_ALLOWED_EMAILS": "pedro@vezza.com.br",
    "PREVIEW_CONTROL_REPOSITORY": "pedropaulovc/agent-sessions-backup",
    "PREVIEW_CONTROL_DEFAULT_REF": "refs/heads/main",
    "PREVIEW_CONTROL_DEPLOY_AUD": "urn:sessions:preview-control:deploy:v1",
    "PREVIEW_CONTROL_CLOSE_AUD": "urn:sessions:preview-control:close:v1",
    "PREVIEW_CONTROL_JANITOR_AUD": "urn:sessions:preview-control:janitor:v1",
    "PREVIEW_CONTROL_DEPLOY_WORKFLOW_REF": "pedropaulovc/agent-sessions-backup/.github/workflows/preview-control.yml@refs/heads/main",
    "PREVIEW_CONTROL_CLOSE_WORKFLOW_REF": "pedropaulovc/agent-sessions-backup/.github/workflows/preview-close.yml@refs/heads/main",
    "PREVIEW_CONTROL_JANITOR_WORKFLOW_REF": "pedropaulovc/agent-sessions-backup/.github/workflows/preview-janitor.yml@refs/heads/main"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PREVIEW_EDGE_AUTH", "class_name": "PreviewEdgeAuth" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PreviewEdgeAuth"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
