{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sessions-ppe",
  "account_id": "18ef3246e9f36d1560485ef53889c0ab",
  "main": "src/ppe.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "routes": [
    { "pattern": "sessions.ppe.vza.net", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "ppe",
    "API_HOST": "sessions.ppe.vza.net",
    "VIEWER_HOST": "sessions.ppe.vza.net",
    "PPE_VIEWER_HOST": "sessions.ppe.vza.net"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sessions-ppe-index",
      "migrations_dir": "migrations-ppe"
    }
  ]
  // Secrets, set with `wrangler secret put --config wrangler.ppe.jsonc`:
  //   PREVIEW_BEARER_SEED — same standing seed used by the per-PR preview jobs.
  //   SETUP_TOKEN — independent one-time first-passkey bootstrap token.
}
