{
  "name": "sessions-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:up": "node scripts/environment.mjs local",
    "dev:reset": "node scripts/environment.mjs reset",
    "preview:open": "node scripts/preview-open.mjs",
    "session:seed-corpus": "node ../scripts/seed-local.mjs",
    "deploy": "node -e \"console.error('Production deployment is protected main CI only; do not authenticate production locally.'); process.exit(1)\"",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run && npm run test:migrations && npm run test:cloudflare-api-budget && npm run test:dev-lifecycle && npm run test:preview-open && npm run test:preview-upload && npm run test:preview-seed && npm run test:preview-smoke && npm run test:provision-queues",
    "test:e2e": "playwright test",
    "test:dev-lifecycle": "node --test test/dev-lifecycle.node.test.mjs",
    "test:preview-open": "node --test test/preview-open.node.test.mjs",
    "test:preview-upload": "node --test test/preview-upload.node.test.mjs",
    "test:preview-seed": "node --test test/preview-control-seed.node.test.mjs test/preview-control-deployment.node.test.mjs",
    "test:preview-smoke": "node --test test/preview-control-smoke.node.test.mjs",
    "test:provision-queues": "node --test test/provision-queues.node.test.mjs",
    "test:migrations": "node --test test/migrations.acceptance.mjs test/index-migration.node.test.mjs test/catalog-migrations.node.test.mjs",
    "test:cloudflare-api-budget": "node --test test/cloudflare-api-budget.node.test.mjs",
    "migrations": "node scripts/migrations.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.1",
    "miniflare": "4.20260710.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.111.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "fflate": "0.8.2"
  }
}
